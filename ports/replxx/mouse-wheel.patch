diff --git a/src/escape.cxx b/src/escape.cxx
index dda1ab0..04153d0 100644
--- a/src/escape.cxx
+++ b/src/escape.cxx
@@ -808,6 +808,34 @@ static char32_t escLeftBracket9Routine(char32_t c) {
 	return escFailureRoutine(c);
 }
 
+// Avenoir : ESC [ < bouton ; x ; y M|m, événement de souris en mode SGR
+// (DECSET 1006). La molette donne WHEEL_UP / WHEEL_DOWN, tout autre événement
+// MOUSE (à ignorer) : sans cela, la séquence serait tapée comme du texte.
+static char32_t sgrMouseRoutine(char32_t) {
+	unsigned int button = 0;
+	int field = 0;
+	for (int i = 0; i < 32; ++i) {
+		char32_t c = read_unicode_character();
+		if (c == 0) return 0;
+		if (c == 'M' || c == 'm') {
+			if (c == 'M' && field == 2) {
+				switch (button & ~0x1cU) { // sans Maj, Méta, Ctrl
+					case 64: return Replxx::KEY::WHEEL_UP;
+					case 65: return Replxx::KEY::WHEEL_DOWN;
+					default: break;
+				}
+			}
+			return Replxx::KEY::MOUSE;
+		}
+		if (c == ';') {
+			++field;
+		} else if (field == 0 && c >= '0' && c <= '9' && button < 1000) {
+			button = button * 10 + static_cast<unsigned int>(c - '0');
+		}
+	}
+	return Replxx::KEY::MOUSE;
+}
+
 // Handle ESC [ <more stuff> escape sequences
 //
 static CharacterDispatchRoutine escLeftBracketRoutines[] = {
@@ -817,9 +845,9 @@ static CharacterDispatchRoutine escLeftBracketRoutines[] = {
 	escLeftBracket0Routine, escLeftBracket1Routine, escLeftBracket2Routine,
 	escLeftBracket3Routine, escLeftBracket4Routine, escLeftBracket5Routine,
 	escLeftBracket6Routine, escLeftBracket7Routine, escLeftBracket8Routine,
-	escLeftBracket9Routine, escFailureRoutine
+	escLeftBracket9Routine, sgrMouseRoutine,        escFailureRoutine
 };
-static CharacterDispatch escLeftBracketDispatch = {17, "ABCDHFZ0123456789",
+static CharacterDispatch escLeftBracketDispatch = {18, "ABCDHFZ0123456789<",
 																									 escLeftBracketRoutines};
 
