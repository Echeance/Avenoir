+++ b/src/escape.cxx
@@ -808,6 +808,37 @@ static char32_t escLeftBracket9Routine(char32_t c) {
 	return escFailureRoutine(c);
 }
 
+// Avenoir : ESC [ < bouton ; x ; y M|m, événement de souris en mode SGR
+// (DECSET 1006). La molette donne WHEEL_UP / WHEEL_DOWN, tout autre événement
+// MOUSE (à ignorer) : sans cela, la séquence serait tapée comme du texte.
+static char32_t sgrMouseRoutine(char32_t) {
+	unsigned int fields[3] = { 0, 0, 0 };
+	int field = 0;
+	for (int i = 0; i < 32; ++i) {
+		char32_t c = read_unicode_character();
+		if (c == 0) return 0;
+		if (c == 'M' || c == 'm') {
+			if (c == 'M' && field == 2) {
+				switch (fields[0] & ~0x1cU) { // sans Maj, Méta, Ctrl
+					case 64: return Replxx::KEY::WHEEL_UP;
+					case 65: return Replxx::KEY::WHEEL_DOWN;
+					default: break;
+				}
+			}
+			if (field == 2) {
+				::replxx::avenoir_store_mouse( fields[0], static_cast<int>( fields[1] ), static_cast<int>( fields[2] ), c == 'm' );
+			}
+			return Replxx::KEY::MOUSE;
+		}
+		if (c == ';') {
+			if (field < 2) ++field;
+		} else if (c >= '0' && c <= '9' && fields[field] < 100000) {
+			fields[field] = fields[field] * 10 + static_cast<unsigned int>(c - '0');
+		}
+	}
+	return Replxx::KEY::MOUSE;
+}
