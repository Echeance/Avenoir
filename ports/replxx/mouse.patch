@@ -42,6 +42,33 @@ using namespace std;
 
 namespace replxx {
 
+// Avenoir : dernier événement de souris (voir replxx.hxx).
+static bool avenoirMousePending = false;
+static unsigned int avenoirMouseButton = 0;
+static int avenoirMouseColumn = 0;
+static int avenoirMouseRow = 0;
+static bool avenoirMouseRelease = false;
+
+void avenoir_store_mouse( unsigned int button_, int column_, int row_, bool release_ ) {
+	avenoirMouseButton = button_;
+	avenoirMouseColumn = column_;
+	avenoirMouseRow = row_;
+	avenoirMouseRelease = release_;
+	avenoirMousePending = true;
+}
+
+bool avenoir_take_mouse( unsigned int& button_, int& column_, int& row_, bool& release_ ) {
+	if ( ! avenoirMousePending ) {
+		return false;
+	}
+	avenoirMousePending = false;
+	button_ = avenoirMouseButton;
+	column_ = avenoirMouseColumn;
+	row_ = avenoirMouseRow;
+	release_ = avenoirMouseRelease;
+	return true;
+}
